@* 5 *@
@page "/admin-dashboard"

@using Employees.UI.Services
@using Employees.UI.Models

@rendermode InteractiveServer

@inject HttpClientWrapper HttpClient
@inject UserSession UserSession
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard</PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="alert alert-danger">
You are not logged in. </div>
}
else if (UserSession.Role != "Admin")
{ <div class="alert alert-danger">
Access denied. Admin access required. </div>
}
else
{ <div class="container mt-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Admin Dashboard</h2>

            <p class="text-muted mb-0">
                Welcome, @UserSession.Name
            </p>
        </div>

        <div>
            <button class="btn btn-danger"
                    @onclick="Logout">
                Logout
            </button>
        </div>

    </div>


    <!-- Admin Information -->

    <div class="card mb-4 shadow-sm">

        <div class="card-body">

            <h5 class="card-title">
                Admin Information
            </h5>

            <div class="row">

                <div class="col-md-4">
                    <strong>Name:</strong>
                    @UserSession.Name
                </div>

                <div class="col-md-4">
                    <strong>Email:</strong>
                    @UserSession.Email
                </div>

                <div class="col-md-4">
                    <strong>Role:</strong>
                    @UserSession.Role
                </div>

            </div>

        </div>

    </div>


    <!-- Department Selection -->

    <div class="card mb-4 shadow-sm">

        <div class="card-header">
            <strong>Select Department</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- Department -->

                <div class="col-md-6">

                    <label class="form-label">
                        Department
                    </label>

                    <select class="form-select"
                            @bind="SelectedDepartment">

                        <option value="">
                            Select Department
                        </option>

                        <option value="HR">
                            HR
                        </option>

                        <option value="Technical">
                            Technical
                        </option>

                    </select>

                </div>


                <!-- Team -->

                <div class="col-md-6">

                    <label class="form-label">
                        Team
                    </label>

                    <select class="form-select"
                            @bind="SelectedTeam"
                            disabled="@string.IsNullOrEmpty(SelectedDepartment)">

                        <option value="">
                            Select Team
                        </option>

                        @if (SelectedDepartment == "HR")
                        {
                            <option value="Designers">
                                Designers
                            </option>

                            <option value="Development">
                                Development
                            </option>

                            <option value="SEO">
                                SEO
                            </option>

                            <option value="Sales">
                                Sales
                            </option>
                        }

                        @if (SelectedDepartment == "Technical")
                        {
                            <option value="System Engineer">
                                System Engineer
                            </option>

                            <option value="DevOps">
                                DevOps
                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>

    </div>


    <!-- Selected Department -->

    @if (!string.IsNullOrEmpty(SelectedDepartment))
    {
        <div class="alert alert-info">

            <strong>
                Selected Department:
            </strong>

            @SelectedDepartment

            @if (!string.IsNullOrEmpty(SelectedTeam))
            {
                <span>
                    &nbsp; | &nbsp;

                    <strong>
                        Team:
                    </strong>

                    @SelectedTeam
                </span>
            }

        </div>
    }


    <!-- Employee Management -->

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between">

            <strong>
                Employee Management
            </strong>

            <button class="btn btn-primary btn-sm"
                    @onclick="OpenEmployeePage">

                Manage Employees

            </button>

        </div>

        <div class="card-body">

            @if (string.IsNullOrEmpty(SelectedDepartment))
            {
                <p class="text-muted">
                    Select a department to view employees.
                </p>
            }
            else
            {
                <p>
                    You selected:

                    <strong>
                        @SelectedDepartment
                    </strong>

                    @if (!string.IsNullOrEmpty(SelectedTeam))
                    {
                        <span>
                            /
                            <strong>
                                @SelectedTeam
                            </strong>
                        </span>
                    }
                </p>

                <button class="btn btn-success"
                        @onclick="OpenEmployeePage">

                    View Employee CRUD

                </button>
            }

        </div>

    </div>

</div>

}

