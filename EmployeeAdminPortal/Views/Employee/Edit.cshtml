@model Employee.Data.Models.Employee1

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-4">

    <h2>Edit Employee</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Age</label>
            <input asp-for="Age"
                   type="number"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Department</label>
            <input asp-for="Department"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Salary</label>
            <input asp-for="Salary"
                   type="number"
                   step="0.01"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-success">
            Update
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>

